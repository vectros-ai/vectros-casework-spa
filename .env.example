# ---------------------------------------------------------------------------
# casework-spa — environment configuration template
#
# Copy this file to `.env.local` for local development. NEVER commit a real
# `.env.local`. In a real deployment these are injected at build time by
# whatever static-hosting pipeline you use (Vercel, Netlify, a CFN stack —
# this app ships no server, so any static host works).
#
# Vite exposes ONLY variables prefixed `VITE_` to the client bundle. None of
# these are secrets: an Auth0 SPA application's domain/client-id are public
# identifiers by design (OAuth's public-client model — the actual proof of
# identity is the user's Auth0 session, not this config), and the exchange
# endpoint is an unauthenticated public URL. Nothing here needs to be hidden
# from the browser that already has to read it to boot.
# ---------------------------------------------------------------------------

# Your Auth0 tenant domain, e.g. "acme-corp.us.auth0.com" (no scheme, no
# trailing slash). Auth0 Dashboard → Applications → your SPA application.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com

# The Auth0 application's Client ID (Auth0 Dashboard → Applications → your
# SPA application → Settings).
VITE_AUTH0_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# The Auth0 API identifier (audience) this SPA application is authorized
# for. Must match the audience the Vectros blueprint registered this issuer
# under (see docs/blueprint's `inputs.auth0Audience`) — the exchange endpoint
# resolves the target tenant + context from the (issuer, audience) pair.
VITE_AUTH0_AUDIENCE=https://casework-api

# Optional — the Auth0 database connection's name, used only by the Account
# page's "send password reset email" button. Defaults to
# "Username-Password-Authentication", Auth0's own out-of-box name for a
# tenant's default database connection; only set this if you renamed it.
# VITE_AUTH0_CONNECTION=Username-Password-Authentication

# Vectros's token-exchange endpoint: `POST /v1/auth/token/exchange`. Trades
# the Auth0 ACCESS token (not the ID token) for a Vectros partner-API bearer.
# Points at your Vectros deployment's API host.
VITE_VECTROS_EXCHANGE_URL=https://api.vectros.ai/v1/auth/token/exchange

# Vectros API base URL. The minted bearer unlocks /v1/* — records, schemas,
# entities, documents, search — all scoped to the (tenant, context) the
# exchange resolved. Typically the same host as above, minus the path.
VITE_VECTROS_API_URL=https://api.vectros.ai
