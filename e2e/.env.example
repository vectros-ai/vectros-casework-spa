# casework-spa e2e smoke suite — copy this file to `.env` and fill in your values.
#
# A DEDICATED test user in YOUR OWN Auth0 tenant — never a real human's
# account. Create one in Auth0 Dashboard -> User Management -> Users, on the
# same database connection your app's login uses, then provision it in your
# Vectros instance (any role works; the broader the role, the more of the
# suite it can exercise — see README.md "Known gaps").

SMOKE_USER_EMAIL=
SMOKE_USER_PASSWORD=

# Optional — your Vectros API base, used by assertions only (not the login
# itself). Defaults to the production API; point it at your own deployment if
# you're running against a different Vectros instance (e.g. a private one).
VECTROS_API_BASE=https://api.vectros.ai

# Optional — required only for `./run.sh --deployed`: your own deployed
# instance's URL (see ../docs/VERCEL-SETUP.md), instead of booting a local
# Vite dev server. Its /callback must be a registered Allowed Callback URL on
# your Auth0 application.
CASEWORK_SPA_DEPLOYED_URL=
